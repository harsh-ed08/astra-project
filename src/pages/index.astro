---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import Heading from "@/components/typography/Heading.astro";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import Card from "@/components/item/Card.astro";
---

<Layout theme="light">
  <Section>
    <ContentWrapper centered>
      <Eyebrow>Lumos + Astro starter</Eyebrow>
      <Heading tag="h1">Build a fast site, make it your own.</Heading>
      <Paragraph
        >A fast Astro starter powered by Lumos components, responsive layouts,
        and a shared CSS design system.</Paragraph
      >
      <ButtonWrapper>
        <Button element="link" href="/about">Get started</Button>
        <Button
          element="link"
          href="https://lumosframework.com"
          emphasis="secondary">Read the docs</Button
        >
      </ButtonWrapper>
    </ContentWrapper>
  </Section>
  <Section paddingTop="none">
    <ContentWrapper centered
      ><Heading tag="h2">Everything you need, nothing you don't</Heading
      ></ContentWrapper
    >
    <Grid medium={3}>
      <Card
        heading="Fast by default"
        text="Astro renders your pages to HTML, with JavaScript only where interaction needs it."
      />
      <Card
        heading="Consistent styling"
        text="Lumos brings shared design tokens, fluid typography, and light, dark, and brand themes."
      />
      <Card
        heading="Reusable components"
        text="Compose pages from sections, grids, cards, and buttons, then make them your own."
      />
    </Grid>
  </Section>
  <Section theme="brand">
    <ContentWrapper centered>
      <Heading tag="h2">Ready to make it yours?</Heading>
      <Paragraph
        >Explore the components and start building your next page.</Paragraph
      >
      <ButtonWrapper
        ><Button element="link" href="/example-components"
          >Explore components</Button
        ></ButtonWrapper
      >
    </ContentWrapper>
  </Section>
</Layout>
