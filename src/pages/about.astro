---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import ContentWrapper from "@/components/wrapper/ContentWrapper.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Grid from "@/components/wrapper/Grid.astro";
import Heading from "@/components/typography/Heading.astro";
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import Card from "@/components/item/Card.astro";
---

<Layout title="About" theme="light">
  <Section>
    <ContentWrapper centered>
      <Eyebrow>About</Eyebrow>
      <Heading tag="h1">A starter that stays out of your way.</Heading>
      <Paragraph
        >Northwind is built with Astro and Lumos. Reusable components and plain
        CSS custom properties keep your pages consistent and easy to change.</Paragraph
      >
      <ButtonWrapper
        ><Button element="link" href="/">Back home</Button></ButtonWrapper
      >
    </ContentWrapper>
  </Section>
  <Section paddingTop="none">
    <ContentWrapper centered
      ><Heading tag="h2">How it's organized</Heading></ContentWrapper
    >
    <Grid medium={3}>
      <Card
        heading="Pages"
        text="Each route is an Astro file in src/pages, composed from Lumos components."
      />
      <Card
        heading="Components"
        text="Reusable layout, typography, media, form, and interactive components live in src/components."
      />
      <Card
        heading="Styles"
        text="Design tokens, shared patterns, and utilities live in src/styles. Each component carries its own styles."
      />
    </Grid>
  </Section>
</Layout>
